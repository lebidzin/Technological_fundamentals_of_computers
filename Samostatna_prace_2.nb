Cell[TextData[{
 "2) Vy\[RHacek]e\[SHacek]te soustavu rovnic, v\[YAcute]sledek \
dosa\[DHacek]te do v\[YAcute]razu ",
 StyleBox["vyr", "Program",
  FontWeight->"Bold"],
 ".  Hodnotu v\[YAcute]razu ",
 StyleBox["vyr", "Program",
  FontWeight->"Bold"],
 " po dosazen\[IAcute] zobrazte jako desetinn\[EAcute] \[CHacek]\[IAcute]slo."
}], "Text",ExpressionUUID->"557549ef-210a-4e33-8112-17f45d3e592c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"soustava", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "15"}], "x"}], "+", 
       RowBox[{"6", "z"}]}], "\[Equal]", "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"8.2", "x"}], "+", 
       RowBox[{"7", "y"}], "-", 
       RowBox[{"3", "z"}]}], "\[Equal]", 
      RowBox[{"-", "9"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"8", "x"}], "-", 
       RowBox[{"2", "y"}], "+", "z"}], "\[Equal]", "1"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vyr", "=", 
   RowBox[{
    RowBox[{"2", 
     SuperscriptBox["x", "3"]}], "+", 
    RowBox[{"3", "y"}], "-", 
    RowBox[{"6", 
     SuperscriptBox["z", "2"]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reseni", " ", "=", " ", 
   RowBox[{"Solve", "[", 
    RowBox[{"soustava", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"N", "[", 
  RowBox[{"vyr", " ", "/.", 
   RowBox[{"First", "[", "reseni", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.000553018239214*^9, 4.0005530515583487`*^9}, {
  4.000553139674468*^9, 4.000553141508334*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"ded72eea-beb5-4220-b665-33d017188c1a"],

Cell[BoxData[
 RowBox[{"-", "4.628241432896069`"}]], "Output",
 CellChangeTimes->{4.000553056341494*^9, 4.0005531428542*^9},
 CellLabel->"Out[38]=",ExpressionUUID->"78c0ca7f-5ccc-43e8-b7dd-d53043ffa0c0"]
}, Open  ]],

Cell[TextData[{
 "3) Vy\[RHacek]e\[SHacek]te soustavu difrovnic pro soustavu po\[CHacek]\
\[AAcute]te\[CHacek]n\[IAcute]ch podm\[IAcute]nek, pro ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "t", "\[LessEqual]", "5"}], TraditionalForm]],
  ExpressionUUID->"606be0b0-15ef-4731-89e5-fe5bd85659f1"],
 "; vytiskn\[EHacek]te graf ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "ad205733-850e-4eb5-b34a-82f1578d163c"],
 " a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x2", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "5f504329-8475-441d-993d-b9181d81f3e4"],
 " a pomoc\[IAcute] p\[RHacek]\[IAcute]kazu ",
 StyleBox["ParametricPlot", "Program",
  FontWeight->"Bold"],
 " tak\[EAcute] vytiskn\[EHacek]te graf  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "37ddb567-aae5-482e-b365-4f4c8616cde9"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x2", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "ca749fe9-c7a7-424d-b2ab-7f65786cec3a"],
 ", tj. graf s funkc\[IAcute] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "e4373542-2957-4193-8b6c-18d9c3e284aa"],
 " na vodorovn\[EAcute] ose a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x2", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "f34a4eee-338b-4570-b390-004456057dcf"],
 " na svisl\[EAcute] ose."
}], "Text",ExpressionUUID->"6fbcd239-379c-400c-a4fd-31884700a157"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"soustavaRovnic", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x1", "'"}], "[", "t", "]"}], "+", 
       RowBox[{"x2", "[", "t", "]"}]}], "\[Equal]", 
      RowBox[{
       FractionBox[
        RowBox[{"-", "3"}], "10"], "*", 
       RowBox[{"x1", "[", "t", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"x1", "[", "t", "]"}], "-", 
       RowBox[{
        RowBox[{"x2", "'"}], "[", "t", "]"}]}], "\[Equal]", 
      RowBox[{"1", "*", 
       RowBox[{"x2", "[", "t", "]"}]}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"soustavaPodminek", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"x1", "[", "0", "]"}], "\[Equal]", 
      RowBox[{"-", 
       FractionBox["1", "2"]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "0"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reseni", "=", 
   RowBox[{"First", "[", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"soustavaRovnic", ",", "soustavaPodminek"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "5"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x1", "[", "t", "]"}], ",", 
       RowBox[{"x2", "[", "t", "]"}]}], "}"}], "/.", "reseni"}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Blue"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x1(t)\>\"", ",", "\"\<x2(t)\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<hodnota\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x1", "[", "t", "]"}], ",", 
       RowBox[{"x2", "[", "t", "]"}]}], "}"}], "/.", "reseni"}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x1(t)\>\"", ",", "\"\<x2(t)\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{4.000553157948306*^9, 4.0005532078510323`*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"e167027a-ee64-4b3a-8cec-c4ba8bdc20d3"],

