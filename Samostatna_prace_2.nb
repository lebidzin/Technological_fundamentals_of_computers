Cell[TextData[{
 "1) Zadefinujte funkci ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "9fc1546b-4b40-49d2-9f47-dec8bb1d3c77"],
 " takovou, \[ZHacek]e ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "x", ")"}], "=", 
    RowBox[{"arctg", "(", 
     SuperscriptBox["x", 
      FractionBox["3", "2"]], ")"}]}], TraditionalForm]],ExpressionUUID->
  "cee0540a-9d41-469a-81eb-b089b4cd1f52"],
 " a vytiskn\[EHacek]te graf t\[EAcute]to funkce v argumentu ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{"cosh", "(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "956ef6b8-da00-4e97-970d-152c48078caa"],
 " pro ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "5"}], "\[LessEqual]", "t", "\[LessEqual]", "5"}], 
   TraditionalForm]],ExpressionUUID->"4f623152-6d8e-4584-8cbb-b8ad9f69eec1"],
 ", (libovoln\[EHacek]) popi\[SHacek]te osy a k\[RHacek]ivka nech\[THacek] je \
",
 "\[ZHacek]lut\[AAcute]",
 "."
}], "Text",ExpressionUUID->"b597c095-1250-4137-a4e2-bdf2bc2082a8"],

Cell[BoxData[""], "Input",ExpressionUUID->"e2f148a4-07c1-4af8-81fc-a21a1a7fc2ce"],

Cell[TextData[{
 "2) Vy\[RHacek]e\[SHacek]te soustavu rovnic, v\[YAcute]sledek \
dosa\[DHacek]te do v\[YAcute]razu ",
 StyleBox["vyr", "Program",
  FontWeight->"Bold"],
 ".  Hodnotu v\[YAcute]razu ",
 StyleBox["vyr", "Program",
  FontWeight->"Bold"],
 " po dosazen\[IAcute] zobrazte jako desetinn\[EAcute] \[CHacek]\[IAcute]slo."
}], "Text",ExpressionUUID->"b83e67f8-90fb-4057-9f0e-3a391abee1d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"soustava", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "15"}], "x"}], "+", 
       RowBox[{"3", "y"}]}], "\[Equal]", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"8", "x"}], "+", 
       RowBox[{"5", "y"}], "-", 
       RowBox[{"10", "z"}]}], "\[Equal]", "10"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"5", "x"}], "-", "y", "+", "z"}], "\[Equal]", "1"}]}], "}"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vyr", "=", 
   RowBox[{
    SqrtBox["x"], "+", 
    RowBox[{"2", "y"}], "-", 
    RowBox[{"6", 
     SuperscriptBox["z", "2"]}]}]}], ";"}], "\[IndentingNewLine]"}], "Input",E\
xpressionUUID->"87e1a2a8-5348-4bfe-9dd6-def2ab0baf2d"],

Cell[TextData[{
 "3) Vy\[RHacek]e\[SHacek]te soustavu difrovnic pro soustavu po\[CHacek]\
\[AAcute]te\[CHacek]n\[IAcute]ch podm\[IAcute]nek, pro ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "t", "\[LessEqual]", "50"}], 
   TraditionalForm]],ExpressionUUID->"46cb10af-6d7d-4fc6-a309-e0137aaf3095"],
 "; vytiskn\[EHacek]te graf ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "c9c8bd7d-3ce4-4077-af57-db4deb550035"],
 " a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "e8b16323-84a7-4964-b190-49cce3205dee"],
 " a pomoc\[IAcute] p\[RHacek]\[IAcute]kazu ",
 StyleBox["ParametricPlot", "Program",
  FontWeight->"Bold"],
 " tak\[EAcute] vytiskn\[EHacek]te graf  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "56c6555f-80f1-4cec-81d9-4274883343ea"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "05cafd39-7bcb-4cc0-913b-160f6b44e8ba"],
 ", tj. graf s funkc\[IAcute] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "a3229188-f74b-4d37-8a06-1b9492fc80e6"],
 " na vodorovn\[EAcute] ose a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "f0546e33-6659-4572-9eae-2fa79c81be04"],
 " na svisl\[EAcute] ose."
}], "Text",ExpressionUUID->"c2754ece-4f5d-40b4-abcc-1e73ead4f38a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"soustavaRovnic", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "'"}], "[", "t", "]"}], "+", 
       RowBox[{"g", "[", "t", "]"}]}], "\[Equal]", 
      RowBox[{
       FractionBox[
        RowBox[{"-", "1"}], "2"], "*", 
       RowBox[{"f", "[", "t", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", "t", "]"}], "-", 
       RowBox[{
        RowBox[{"g", "'"}], "[", "t", "]"}]}], "\[Equal]", "1"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"soustavaPodminek", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
     RowBox[{
      RowBox[{"g", "[", "0", "]"}], "\[Equal]", "1"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",ExpressionUUID->"c52886e3-5065-4bea-\
9778-4f29303420fd"]
}, Open  ]]
}, Open  ]]
