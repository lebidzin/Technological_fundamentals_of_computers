Cell[TextData[{
 "1) Zadefinujte funkci ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "dd33d424-7650-4c24-ab8f-cf333751faac"],
 " takovou, \[ZHacek]e ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     RowBox[{
      RowBox[{"f", "(", "x", ")"}], "=", 
      RowBox[{"cos", "(", 
       SuperscriptBox["x", 
        FractionBox["3", "2"]]}]}],
     TraditionalForm], ")"}], TraditionalForm]],ExpressionUUID->
  "14d43e8c-3008-4a05-a1c0-f1f5da87d94f"],
 " a vytiskn\[EHacek]te graf t\[EAcute]to funkce v argumentu ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"ln", "[", "t", "]"}], ")"}], "2"]}], TraditionalForm]],
  ExpressionUUID->"1bb53d9d-3e93-4b5f-90d3-3fabdfd4c2dd"],
 " pro ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LessEqual]", "t", "\[LessEqual]", "5"}], TraditionalForm]],
  ExpressionUUID->"f32487c1-246d-4bae-91f4-5581a130d7df"],
