Cell[TextData[{
 "3) Vy\[RHacek]e\[SHacek]te soustavu difrovnic pro soustavu po\[CHacek]\
\[AAcute]te\[CHacek]n\[IAcute]ch podm\[IAcute]nek, pro ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "t", "\[LessEqual]", "40"}], 
   TraditionalForm]],ExpressionUUID->"d2f445cc-b66b-4c79-b234-34f439b4882b"],
 "; vytiskn\[EHacek]te graf ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "e93fb32e-5b8a-40fc-b4cd-3bf59c49c676"],
 " a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "4430754a-1d58-4575-9d6f-c1e6650723a6"],
 " a pomoc\[IAcute] p\[RHacek]\[IAcute]kazu ",
 StyleBox["ParametricPlot", "Program",
  FontWeight->"Bold"],
 " tak\[EAcute] vytiskn\[EHacek]te graf  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "87c06024-0d96-4623-9d5e-26e475936d54"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "24c1cce6-d73e-402b-9c31-99fd72d08002"],
 ", tj. graf s funkc\[IAcute] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "f2a6720e-532b-474e-a8c6-24c4b2ad406d"],
 " na vodorovn\[EAcute] ose a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "8b862854-c7cb-48a1-90cd-c418750268a6"],
 " na svisl\[EAcute] ose."
}], "Text",
 CellChangeTimes->{{4.000197636073545*^9, 
  4.000197638617724*^9}},ExpressionUUID->"cea6731f-91e7-451d-a6d0-\
8890212bc9f9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "g", ",", "t"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"soustavaRovnic", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"3", 
        RowBox[{
         RowBox[{"f", "'"}], "[", "t", "]"}]}], "+", 
       RowBox[{"2", 
        RowBox[{"g", "[", "t", "]"}]}]}], "\[Equal]", 
      RowBox[{
       FractionBox[
        RowBox[{"-", "E"}], "10"], "*", 
       RowBox[{"f", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"5", 
        RowBox[{"f", "[", "t", "]"}]}], "-", 
       RowBox[{
        RowBox[{"g", "'"}], "[", "t", "]"}]}], "\[Equal]", "0"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"soustavaPodminek", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"g", "[", "0", "]"}], "\[Equal]", "1"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reseni", "=", 
   RowBox[{"First", "[", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"soustavaRovnic", ",", "soustavaPodminek"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"f", ",", "g"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "40"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f", "[", "t", "]"}], ",", 
        RowBox[{"g", "[", "t", "]"}]}], "}"}], "/.", "reseni"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "40"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Red", ",", "Blue"}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<f(t)\>\"", ",", "\"\<g(t)\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<t\>\"", ",", "\"\<hodnota\>\""}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", "t", "]"}], ",", 
       RowBox[{"g", "[", "t", "]"}]}], "}"}], "/.", "reseni"}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "40"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<f(t)\>\"", ",", "\"\<g(t)\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{4.000196807871077*^9, 4.000196867591084*^9}, {
  4.000196936151353*^9, 4.000196973175418*^9}, {4.000197031959841*^9, 
