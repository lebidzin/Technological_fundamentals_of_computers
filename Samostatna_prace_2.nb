Cell[BoxData[{
 RowBox[{
  RowBox[{"uloha", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"b", "+", 
       RowBox[{"2", " ", "c"}], "+", "a"}], "\[Equal]", "3"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"5", " ", "a"}], "-", 
       RowBox[{"3", " ", "b"}], "+", 
       RowBox[{"2", " ", "c"}]}], "\[Equal]", 
      RowBox[{"-", "4"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "21"}], " ", "a"}], "+", 
       RowBox[{"15", " ", "c"}]}], "\[Equal]", "3"}]}], "\[IndentingNewLine]",
     "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vyr", "=", 
   RowBox[{
    SqrtBox["a"], "+", 
    SuperscriptBox["b", "2"], "+", 
    SuperscriptBox["c", "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reseni", "=", 
   RowBox[{"Solve", "[", "\[IndentingNewLine]", 
    RowBox[{"uloha", ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"reseni", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"gives", " ", "the", " ", "first", " ", "element", " ", 
    RowBox[{
     StyleBox[
      RowBox[{"in", 
       StyleBox["expr", "TI"]}]], "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"N", "[", 
  RowBox[{"vyr", " ", "/.", 
   RowBox[{"First", "[", "reseni", "]"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{4.000196437741831*^9, 4.0001964809642076`*^9}, {
   4.0001965678463287`*^9, 4.000196644238196*^9}, {4.000196729871146*^9, 
   4.00019673601499*^9}, 4.000197077480184*^9, {4.000552404025009*^9, 
   4.000552407397455*^9}},ExpressionUUID->"6d801a60-4602-41f8-afea-\
f5d51752526e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"a", "\[Rule]", 
     FractionBox["17", "96"]}], ",", 
    RowBox[{"b", "\[Rule]", 
     FractionBox["185", "96"]}], ",", 
    RowBox[{"c", "\[Rule]", 
     FractionBox["43", "96"]}]}], "}"}], "}"}]], "Output",
