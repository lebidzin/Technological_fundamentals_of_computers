Cell[TextData[{
 "1) Zadefinujte funkci ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "ab98688d-ad4b-4461-bf03-df6df8430e20"],
 " takovou, \[ZHacek]e ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{"sinh", "(", 
     SuperscriptBox["x", "2"], ")"}]}], TraditionalForm]],ExpressionUUID->
  "5b0a1abf-4525-468b-9a9d-9e9b11e3ddc2"],
 " a vytiskn\[EHacek]te graf t\[EAcute]to funkce v argumentu ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{"\[Sqrt]", 
     RowBox[{"(", 
      RowBox[{"t", "+", "1"}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "083e107c-9197-4938-80f1-2ba299f6b2b0"],
 " pro ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "1"}], "\[LessEqual]", "t", "\[LessEqual]", "1"}], 
   TraditionalForm]],ExpressionUUID->"4e879503-4791-48a0-aad9-4f61b2825220"],
 ", (libovoln\[EHacek]) popi\[SHacek]te osy a k\[RHacek]ivka nech\[THacek] je \
siln\[AAcute] a \[CHacek]erven\[AAcute]."
}], "Text",ExpressionUUID->"abcac965-c3ee-418a-a525-92bcdfe577c4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{"Sinh", "[", 
    RowBox[{"x", "^", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", "+", "1"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<f\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", "Red"}], "}"}]}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
