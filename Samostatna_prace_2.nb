Cell[TextData[{
 "1) Zadefinujte funkci ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "22445db1-3626-454a-8628-2b57a1c18b52"],
 " takovou, \[ZHacek]e ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "x", ")"}], "=", 
    RowBox[{"cosh", "(", 
     SuperscriptBox["x", "2"], ")"}]}], TraditionalForm]],ExpressionUUID->
  "6845e364-31ab-4d3d-b056-bcea01fc88f5"],
 " a vytiskn\[EHacek]te graf t\[EAcute]to funkce v argumentu ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    SqrtBox[
     RowBox[{"t", "+", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "15d7ecf9-3334-4ed2-a888-c81504e7dbef"],
 " pro ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "t", "\[LessEqual]", "2"}], TraditionalForm]],
  ExpressionUUID->"b5fdb75c-b49a-497d-9718-f80f4adaa42f"],
 ", (libovoln\[EHacek]) popi\[SHacek]te osy a k\[RHacek]ivka nech\[THacek] je \
siln\[AAcute] a modr\[AAcute]."
}], "Text",ExpressionUUID->"58e164b5-ebf6-4ec0-9f8b-0ecc9963cf8e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", "x_", "]"}], ":=", 
   RowBox[{"Cosh", "[", 
    RowBox[{"x", "^", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"y", "[", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", "+", "2"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", " ", "\"\<y\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", " ", "Blue"}], "}"}]}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{4.0005520903247766`*^9, 4.000552121781733*^9}, {
