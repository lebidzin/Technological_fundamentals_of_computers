Cell[TextData[{
 "2) Vy\[RHacek]e\[SHacek]te soustavu rovnic, v\[YAcute]sledek \
dosa\[DHacek]te do v\[YAcute]razu ",
 StyleBox["vyr", "Program",
  FontWeight->"Bold"],
 ".  Hodnotu v\[YAcute]razu ",
 StyleBox["vyr", "Program",
  FontWeight->"Bold"],
 " po dosazen\[IAcute] zobrazte jako desetinn\[EAcute] \[CHacek]\[IAcute]slo."
}], "Text",ExpressionUUID->"a3f417dc-61af-4d19-97fc-77a143f71f46"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"uloha", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "b"}], "+", 
       RowBox[{"3", "a"}]}], "\[Equal]", "3"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "6"}], " ", "a"}], "+", 
       RowBox[{"17", " ", "b"}], "+", 
       RowBox[{"2", " ", "c"}]}], "\[Equal]", "14"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "21"}], " ", "a"}], "+", 
       RowBox[{"15", " ", "c"}]}], "\[Equal]", "3"}]}], "\[IndentingNewLine]",
     "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vyr", "=", 
   RowBox[{"a", "+", "b", "-", "c"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reseni", " ", "=", " ", 
   RowBox[{"Solve", "[", 
    RowBox[{"uloha", ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"N", "[", 
  RowBox[{"vyr", " ", "/.", 
   RowBox[{"First", "[", "reseni", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.000552324863945*^9, 4.000552333471983*^9}, {
  4.000552416644266*^9, 4.000552456519108*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"22fa3763-db62-483d-a619-a4ef5e7dbae6"],

Cell[BoxData["0.3138075313807531`"], "Output",
 CellChangeTimes->{{4.000552463929303*^9, 4.000552466269031*^9}},
 CellLabel->"Out[16]=",ExpressionUUID->"7ab823b6-46c2-4bf0-b4af-ab7f3eb38079"]
}, Open  ]],

Cell[TextData[{
 "3) Vy\[RHacek]e\[SHacek]te soustavu difrovnic pro soustavu po\[CHacek]\
\[AAcute]te\[CHacek]n\[IAcute]ch podm\[IAcute]nek, pro ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "t", "\[LessEqual]", "50"}], 
   TraditionalForm]],ExpressionUUID->"bbae1778-93c2-4ae7-b027-bfb3f7b0567d"],
 "; vytiskn\[EHacek]te graf ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "cca7b33f-9f4f-4dfa-b462-bf828a8edba0"],
 " a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x2", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "c64f1a61-a3dc-4fa5-a802-25b0555b54a3"],
 " a pomoc\[IAcute] p\[RHacek]\[IAcute]kazu ",
 StyleBox["ParametricPlot", "Program",
  FontWeight->"Bold"],
 " tak\[EAcute] vytiskn\[EHacek]te graf  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "dd20cebb-8866-41a2-94a1-f0c6d23992be"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x2", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "3479fb3e-92f9-4260-a29b-efb6b93a8db8"],
 ", tj. graf s funkc\[IAcute] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "434dd248-6130-46f8-9afe-749ba21aeb59"],
 " na vodorovn\[EAcute] ose a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x2", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "9a7743b7-19df-42ef-9909-66cd8bce5b3b"],
 " na svisl\[EAcute] ose."
}], "Text",ExpressionUUID->"41905cf0-e825-46f2-86c1-3fb3fef7967b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"soustavaRovnic", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x1", "'"}], "[", "t", "]"}], "+", 
       RowBox[{"x2", "[", "t", "]"}]}], "\[Equal]", 
      RowBox[{
       FractionBox[
        RowBox[{"-", "3"}], "10"], "*", 
       RowBox[{"x1", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"x1", "[", "t", "]"}], "-", 
       RowBox[{
        RowBox[{"x2", "'"}], "[", "t", "]"}]}], "\[Equal]", "1"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"soustavaPodminek", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"x1", "[", "0", "]"}], "\[Equal]", 
      FractionBox["1", "2"]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "0"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reseni", "=", 
   RowBox[{"First", "[", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"soustavaRovnic", ",", "soustavaPodminek"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "50"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x1", "[", "t", "]"}], ",", 
       RowBox[{"x2", "[", "t", "]"}]}], "}"}], "/.", "reseni"}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Blue"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x1(t)\>\"", ",", "\"\<x2(t)\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<hodnota\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x1", "[", "t", "]"}], ",", 
       RowBox[{"x2", "[", "t", "]"}]}], "}"}], "/.", "reseni"}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x1(t)\>\"", ",", "\"\<x1(t)\>\""}], "}"}]}]}], 
