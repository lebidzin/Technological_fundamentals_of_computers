Cell[BoxData[{
 RowBox[{
  RowBox[{"soustavaRovnic", ":=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"f", "[", "t", "]"}]}], "+", 
       RowBox[{"7", "*", 
        RowBox[{
         RowBox[{"g", "'"}], "[", "t", "]"}]}]}], "==", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"Pi", "/", "2"}], ")"}]}], "*", 
       RowBox[{"g", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{
         RowBox[{"f", "'"}], "[", "t", "]"}]}], "-", 
       RowBox[{"5", "*", 
        RowBox[{"g", "[", "t", "]"}]}]}], "==", 
      RowBox[{"1", "/", "20"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"soustavaPodminek", ":=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", "0", "]"}], "==", 
      RowBox[{"-", "7"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"g", "[", "0", "]"}], "==", 
      RowBox[{"-", "2"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reseni", " ", "=", 
   RowBox[{"First", "[", 
    RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"soustavaRovnic", ",", "soustavaPodminek"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"f", ",", "g"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "40"}], "}"}]}], "]"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", "t", "]"}], ",", 
       RowBox[{"g", "[", "t", "]"}]}], "}"}], "/.", "reseni"}], "]"}], ",", 
