Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"uloha4", "=", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], "*", "x"}], "-", 
      RowBox[{"3", "*", "e"}]}], "==", 
     RowBox[{"y", "*", 
      RowBox[{"Tanh", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"6", "*", "Pi"}], ")"}], "/", "7"}], "]"}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"10", "*", "x"}], "-", 
      RowBox[{"8", "*", "y", "*", "n", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"n", "-", 
         RowBox[{"Pi", "/", "2"}]}], "]"}]}]}], "==", 
     RowBox[{"3", "*", "n"}]}]}], "\[IndentingNewLine]", "}"}]}]], "Input",
 CellChangeTimes->{{4.00037724351807*^9, 4.000377243518115*^9}, {
  4.00037730415427*^9, 4.0003773061471148`*^9}},
