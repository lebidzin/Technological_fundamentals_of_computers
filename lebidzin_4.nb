Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "3"}], " ", "e"}], "-", 
     RowBox[{"3", " ", "x"}]}], "\[Equal]", 
    RowBox[{"y", " ", 
     RowBox[{"Tanh", "[", 
      FractionBox[
       RowBox[{"6", " ", "\[Pi]"}], "7"], "]"}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"10", " ", "x"}], "+", 
     RowBox[{"8", " ", "n", " ", "y", " ", 
      RowBox[{"Cos", "[", "n", "]"}]}]}], "\[Equal]", 
    RowBox[{"3", " ", "n"}]}]}], "}"}]], "Output",
